rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Admin list: a user can only read their own admin doc. Created manually in console.
    match /admins/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow write: if false;
    }

    // User profile. Balance can only be changed by an admin (or Cloud Functions, which bypass rules).
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.balance == 0
                    && request.resource.data.antruId is string;
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.balance == resource.data.balance);
      allow delete: if false;
    }

    // Antru ID registry. Create-only: an existing ID can never be overwritten, so IDs stay unique.
    match /antruIds/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Recharge requests: user creates their own (Pending); admin approves or rejects.
    match /rechargeRequests/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == "Pending";
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Transaction history: written only by admin (or Cloud Functions).
    match /transactions/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
